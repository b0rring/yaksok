# 이 파일을 server/.env 로 복사한 뒤 값을 채우세요. 실제 키는 .env에만 두고 절대 커밋하지 않습니다.
# Gemini (약 봉투 읽기, 진료 녹음 요약, 챗봇): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 식약처 e약은요 (공공데이터포털 인증키)
MFDS_API_KEY=
# 심평원 병원·약국 정보 (공공데이터포털 인증키)
HIRA_API_KEY=
# 카카오 지도
KAKAO_JS_KEY=
# 의사 가입용 시연 초대 코드 (비우면 DOCTOR-DEMO)
DOCTOR_INVITE=

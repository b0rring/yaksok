{
  "expo": {
    "name": "약속",
    "slug": "yaksok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "약 사진을 찍기 위해 카메라를 사용해요.",
        "NSPhotoLibraryUsageDescription": "약 사진을 고르기 위해 앨범을 사용해요.",
        "NSMicrophoneUsageDescription": "진료 때 의사 선생님 말씀을 녹음하기 위해 마이크를 사용해요."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F5E52",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-audio",
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#1F5E52" }],
      ["expo-location", { "locationWhenInUsePermission": "가까운 병원과 약국을 찾기 위해 현재 위치를 사용해요." }]
    ]
  }
}